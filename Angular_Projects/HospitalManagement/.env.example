# Angular environments are compile-time files (src/environments/*.ts), not process env vars.
# This file documents what to change when the backend is not on the default gateway:
#   apiBaseUrl  : '' (same origin, `ng serve`/`ng build` + proxy.conf.json -> http://localhost:30080)  or  'http://<gateway-host>:30080'
#   proxy target: proxy.conf.json
# No secrets (tokens, passwords, client secrets) belong in the frontend.
API_GATEWAY=http://localhost:30080
