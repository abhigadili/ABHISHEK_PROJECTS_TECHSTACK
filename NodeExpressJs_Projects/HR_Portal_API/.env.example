# ---- MySQL (existing server, shared with the Java HR Portal) ----
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=change-me
MYSQL_PASSWORD=change-me
DB_POOL_SIZE=10
DB_CONNECT_TIMEOUT_MS=10000
DB_QUERY_TIMEOUT_MS=30000
# ---- Redis / Kafka (infrastructure/docker-compose) ----
REDIS_URL=redis://127.0.0.1:9479
KAFKA_BROKERS=127.0.0.1:9292
KAFKA_CLIENT_PREFIX=hr-node
KAFKA_ENABLED=true
# ---- Security ----
JWT_SECRET=change-me-to-a-long-random-string
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=604800
INTERNAL_SERVICE_TOKEN=change-me-internal
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
CORS_ORIGINS=http://localhost:3000,http://localhost:4200,http://localhost:5173
RATE_LIMIT_PER_MINUTE=300
# bootstrap super admin (created in hr_auth_db when it does not exist)
HR_BOOTSTRAP_ADMIN_USERNAME=nodeadmin
HR_BOOTSTRAP_ADMIN_EMAIL=nodeadmin@hrportal.local
HR_BOOTSTRAP_ADMIN_PASSWORD=change-me
# ---- Files / mail ----
STORAGE_DIR=./storage
MAX_UPLOAD_MB=10
# ---- Service URLs (no hardcoding in code) ----
GATEWAY_PORT=31080
AUTH_SERVICE_URL=http://127.0.0.1:31101
EMPLOYEE_SERVICE_URL=http://127.0.0.1:31102
ORGANIZATION_SERVICE_URL=http://127.0.0.1:31103
LEAVE_SERVICE_URL=http://127.0.0.1:31104
ATTENDANCE_SERVICE_URL=http://127.0.0.1:31105
HOLIDAY_SERVICE_URL=http://127.0.0.1:31106
PAYROLL_SERVICE_URL=http://127.0.0.1:31107
TAX_SERVICE_URL=http://127.0.0.1:31108
PERFORMANCE_SERVICE_URL=http://127.0.0.1:31109
PROJECT_SERVICE_URL=http://127.0.0.1:31110
TIMESHEET_SERVICE_URL=http://127.0.0.1:31111
EXIT_SERVICE_URL=http://127.0.0.1:31112
DOCUMENT_SERVICE_URL=http://127.0.0.1:31113
NOTIFICATION_SERVICE_URL=http://127.0.0.1:31114
REPORTING_SERVICE_URL=http://127.0.0.1:31115
FIELD_ENCRYPTION_KEY=change-me-base64-32-bytes
