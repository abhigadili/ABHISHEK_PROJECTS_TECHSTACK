# Copy to .env and fill in. Never commit .env.
NODE_ENV=development
PORT=4100
API_PREFIX=/api/v1

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=change_me
DB_PASSWORD=change_me
DB_NAME=ems_expressjs
DB_POOL_SIZE=10

# Used by tests only (a separate database whose name must end with _test)
TEST_DB_NAME=ems_expressjs_test

JWT_ACCESS_SECRET=change_me_to_a_long_random_string
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_TTL_DAYS=7
BCRYPT_ROUNDS=12

CORS_ALLOWED_ORIGINS=http://localhost:3000
APP_TIMEZONE=UTC

LOGIN_RATE_LIMIT_MAX=10
API_RATE_LIMIT_MAX=300

# Attendance rules
FULL_DAY_HOURS=6

# Dev only: return the password-reset token in the API response (no SMTP in core)
EXPOSE_RESET_TOKEN=false

# Profile picture / document limits
MAX_UPLOAD_BYTES=2097152

# Initial administrator (read by `npm run admin:create`)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
