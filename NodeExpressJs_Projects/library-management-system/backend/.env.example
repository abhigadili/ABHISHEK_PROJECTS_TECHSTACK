NODE_ENV=development
# Express API port
PORT=4000

# ---- MySQL (application connection - least privilege on the library_management schema) ----
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=lms
# Must satisfy your MySQL password policy. Avoid '#' unless the value is quoted (dotenv treats it as a comment).
DB_PASSWORD=change_me_Str0ng_pw
DB_NAME=library_management
DB_POOL_SIZE=10

# ---- Only used by `npm run db:create` to create the database and the application user ----
# Leave unset if the database and user already exist.
DB_ADMIN_USER=
DB_ADMIN_PASSWORD=

# ---- Web / sessions ----
# Origin(s) allowed by CORS (comma separated). The browser sends the session cookie here.
FRONTEND_ORIGIN=http://localhost:3000
# Used to build password-reset links
APP_BASE_URL=http://localhost:3000
SESSION_COOKIE_NAME=lms_session
SESSION_TTL_HOURS=168
# true when served over HTTPS (required in production); also set TRUST_PROXY=true behind a reverse proxy
COOKIE_SECURE=false
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true

# ---- Uploads ----
MAX_UPLOAD_BYTES=2097152

# ---- Password reset ----
PASSWORD_RESET_TTL_MINUTES=60
# DEVELOPMENT ONLY: returns the reset link in the API response and logs it, because no email
# provider is bundled. Ignored when NODE_ENV=production.
EXPOSE_RESET_LINK=false

# ---- Background jobs (reservation expiry, reminders, membership expiry) ----
JOBS_ENABLED=true

# ---- Optional email/SMS provider ----
# Not implemented: notifications are in-app only. These are placeholders for a future provider.
# SMTP_HOST=

# ---- Development seed only (npm run db:seed) ----
# Password for the demo accounts; if unset a random one is generated and printed once.
# SEED_ADMIN_PASSWORD=
