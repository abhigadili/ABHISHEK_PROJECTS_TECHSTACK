# Copy to .env and fill in MYSQL_PASSWORD. Never commit .env.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=abhig
MYSQL_PASSWORD=<your-mysql-password>
KAFKA_BROKERS=localhost:39092
REDIS_URL=redis://localhost:36379
# HS256 signing key shared by gateway + services (>= 32 chars) - change outside local development
JWT_SECRET=<at-least-32-characters-secret>
# optional tuning: LOG_LEVEL, REMINDER_LEAD_HOURS, REMINDER_CRON, PAYMENT_TIMEOUT_MINUTES, ...
