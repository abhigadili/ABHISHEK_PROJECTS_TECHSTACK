// Prisma schema of the billing-service (database BillingDB). Tables carry the "hjs_" prefix; this service never touches other services' data.
generator client {
  provider = "prisma-client-js"
  output   = "../generated/client"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Bill {
  id             Int        @id @default(autoincrement())
  billNumber     String     @unique(map: "uk_bill_number") @db.VarChar(40)
  patientId      Int
  patientName    String     @db.VarChar(121)
  patientEmail   String?    @db.VarChar(120)
  billType       String     @db.VarChar(12)
  referenceType  String?    @db.VarChar(20)
  referenceId    Int?
  status         String     @default("PENDING") @db.VarChar(12)
  totalAmount    Decimal    @default(0) @db.Decimal(12, 2)
  paidAmount     Decimal    @default(0) @db.Decimal(12, 2)
  currency       String     @default("INR") @db.VarChar(3)
  dueDate        DateTime   @db.Date
  lastReminderAt DateTime?
  note           String?    @db.VarChar(255)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  items          BillItem[]
  payments       Payment[]

  @@unique([referenceType, referenceId], map: "uk_bill_reference")
  @@index([patientId, createdAt], map: "idx_bill_patient")
  @@index([status, dueDate], map: "idx_bill_status_due")
  @@map("hjs_bills")
}

model BillItem {
  id          Int     @id @default(autoincrement())
  billId      Int
  bill        Bill    @relation(fields: [billId], references: [id], onDelete: Cascade)
  description String  @db.VarChar(200)
  quantity    Int
  unitPrice   Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)

  @@map("hjs_bill_items")
}

/// activeBillId equals billId while the payment is PENDING and is NULL afterwards; its unique index guarantees at most one in-flight payment per bill.
model Payment {
  id             Int       @id @default(autoincrement())
  billId         Int
  bill           Bill      @relation(fields: [billId], references: [id], onDelete: Cascade)
  transactionRef String    @unique(map: "uk_payment_txn") @db.VarChar(40)
  amount         Decimal   @db.Decimal(12, 2)
  method         String    @db.VarChar(15)
  status         String    @default("PENDING") @db.VarChar(10)
  activeBillId   Int?      @unique(map: "uk_payment_one_pending_per_bill")
  failureReason  String?   @db.VarChar(255)
  initiatedAt    DateTime  @default(now())
  completedAt    DateTime?

  @@index([status, initiatedAt], map: "idx_payment_status")
  @@map("hjs_payments")
}

// ---- reliable messaging tables (same in every service) ----
model OutboxEvent {
  id            Int       @id @default(autoincrement())
  topic         String    @db.VarChar(150)
  key           String    @db.VarChar(100)
  payload       String    @db.MediumText
  correlationId String?   @db.VarChar(64)
  createdAt     DateTime  @default(now())
  sentAt        DateTime?
  attempts      Int       @default(0)

  @@index([sentAt, id], map: "idx_outbox_unsent")
  @@map("hjs_outbox_events")
}

model ProcessedEvent {
  id          Int      @id @default(autoincrement())
  eventId     String   @db.VarChar(64)
  consumer    String   @db.VarChar(120)
  processedAt DateTime @default(now())

  @@unique([eventId, consumer], map: "uk_processed_event_consumer")
  @@map("hjs_processed_events")
}
