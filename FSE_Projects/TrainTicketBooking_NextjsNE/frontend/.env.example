# Origin of the existing Express.js API (backend default PORT=4000). Used server-side by Server Components, Server Actions and the BFF route handler.
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000
# Public origin of this site (canonical URLs, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared secret for the on-demand revalidation webhook (/api/revalidate). Keep server-side.
REVALIDATE_SECRET=change-me
