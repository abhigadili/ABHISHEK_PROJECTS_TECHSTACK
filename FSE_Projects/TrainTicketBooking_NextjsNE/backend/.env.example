# ---- Server ----
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ---- MySQL (create the database first: CREATE DATABASE train_ticket_booking CHARACTER SET utf8mb4;) ----
# URL-encode special characters in the password (e.g. @ -> %40)
DATABASE_URL=mysql://USER:PASSWORD@127.0.0.1:3306/train_ticket_booking

# ---- Auth ----
# openssl rand -base64 48
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
ACCESS_TOKEN_EXPIRY=15m
REFRESH_TOKEN_EXPIRY_DAYS=7
# true when served over HTTPS (adds the Secure flag to the refresh cookie)
COOKIE_SECURE=false

# ---- E-mail (SMTP). Empty SMTP_HOST = e-mails are printed to the server console ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Train Ticket Booking <no-reply@example.com>"

# ---- Payments ----
# simulation = built-in local gateway (no card data is stored). No other provider is implemented.
PAYMENT_PROVIDER=simulation

# ---- Booking rules ----
SEAT_HOLD_MINUTES=10
MAX_PASSENGERS_PER_BOOKING=6

# ---- Seed ----
# Password for the seeded demo accounts (>= 8 chars with upper, lower and a digit). Quote it if it contains #
SEED_DEFAULT_PASSWORD=
