# Copy to .env and fill in MYSQL_PASSWORD. Never commit .env.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=abhig
MYSQL_PASSWORD=<your-mysql-password>
KAFKA_BOOTSTRAP_SERVERS=localhost:19092
REDIS_HOST=localhost
REDIS_PORT=16379
# HS256 key shared by all services (>= 32 bytes). Change it outside local development.
JWT_SECRET=<at-least-32-characters-secret>
