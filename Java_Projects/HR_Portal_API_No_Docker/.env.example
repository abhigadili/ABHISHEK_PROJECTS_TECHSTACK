# Copy to .env and fill in real values. .env is git-ignored. Only PLACEHOLDERS belong in this file.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_APP_USER=hr_app
MYSQL_APP_PASSWORD=<choose-a-strong-password>
MYSQL_MIGRATION_USER=<existing-mysql-login-with-DDL-and-trigger-rights>
MYSQL_MIGRATION_PASSWORD=<its-password>
KAFKA_BOOTSTRAP_SERVERS=localhost:9192
REDIS_HOST=localhost
REDIS_PORT=9379
REDIS_PASSWORD=
# HS256 signing key shared by all services (>= 32 bytes)
JWT_SECRET=<random-string-of-at-least-32-characters>
# AES-256 key material for column encryption of bank / tax identifiers (>= 16 chars)
HR_DATA_ENCRYPTION_KEY=<random-string-of-at-least-16-characters>
HR_STORAGE_ROOT=./storage
HR_BOOTSTRAP_ADMIN_USERNAME=superadmin
HR_BOOTSTRAP_ADMIN_EMAIL=<admin-email>
HR_BOOTSTRAP_ADMIN_PASSWORD=<strong-initial-password>
# true only in local development: returns the password-reset token in the API response instead of e-mailing it
HR_EXPOSE_RESET_TOKEN=false
