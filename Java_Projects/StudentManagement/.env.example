# Local development values (git-ignored). Copy .env.example -> .env on a new machine.
MYSQL_HOST=host.docker.internal
MYSQL_PORT=3307   # 3307 = socat proxy sidecar (docker compose --profile mysql-proxy ...); use 3306 if MySQL accepts container connections directly
MYSQL_USER=<your-mysql-user>
MYSQL_PASSWORD=<your-mysql-password>
JWT_SECRET=<min-32-char-secret>
ADMIN_PASSWORD=Admin@123
DOCKER_BRIDGE_IP=172.17.0.1
GRAFANA_PASSWORD=admin
