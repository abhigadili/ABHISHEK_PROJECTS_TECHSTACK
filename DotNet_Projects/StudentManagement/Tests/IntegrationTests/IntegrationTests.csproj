    <ProjectReference Include="..\..\Services\CourseService\CourseService.csproj" />
    <ProjectReference Include="..\..\Services\EnrollmentService\EnrollmentService.csproj" />
    <ProjectReference Include="..\..\Services\NotificationService\NotificationService.csproj" />
