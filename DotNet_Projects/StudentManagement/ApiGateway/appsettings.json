{
  "Urls": "http://localhost:8080",
  "AllowedHosts": "*",
  "Jwt": {
    "Secret": "change-me-change-me-change-me-change-me-0123",
    "Issuer": "student-management",
    "Audience": "student-management-api"
  },
  "Cors": {
    "AllowedOrigins": "http://localhost:3000,http://localhost:4200,http://localhost:5173"
  },
  "OpenTelemetry": {
    "OtlpEndpoint": ""
  },
  "ReverseProxy": {
    "Routes": {
      "auth-public": {
        "ClusterId": "student",
        "Order": 0,
        "AuthorizationPolicy": "public",
        "Match": {
          "Path": "/api/auth/{action:regex(^(login|register|refresh|logout)$)}",
          "Methods": [
            "POST"
          ]
        }
      },
      "auth-protected": {
        "ClusterId": "student",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        }
      },
      "students": {
        "ClusterId": "student",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/students/{**catch-all}"
        }
      },
      "students-root": {
        "ClusterId": "student",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/students"
        }
      },
      "courses": {
        "ClusterId": "course",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/courses/{**catch-all}"
        }
      },
      "courses-root": {
        "ClusterId": "course",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/courses"
        }
      },
      "enrollments": {
        "ClusterId": "enrollment",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/enrollments/{**catch-all}"
        }
      },
      "enrollments-root": {
        "ClusterId": "enrollment",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/enrollments"
        }
      },
      "notifications": {
        "ClusterId": "notification",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/notifications/{**catch-all}"
        }
      },
      "notifications-root": {
        "ClusterId": "notification",
        "Order": 1,
        "AuthorizationPolicy": "authenticated",
        "Match": {
          "Path": "/api/notifications"
        }
      },
      "docs-student": {
        "ClusterId": "student",
        "Order": 0,
        "AuthorizationPolicy": "public",
        "Match": {
          "Path": "/docs/student/swagger.json"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/v1/swagger.json"
          }
        ]
      },
      "docs-course": {
        "ClusterId": "course",
        "Order": 0,
        "AuthorizationPolicy": "public",
        "Match": {
          "Path": "/docs/course/swagger.json"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/v1/swagger.json"
          }
        ]
      },
      "docs-enrollment": {
        "ClusterId": "enrollment",
        "Order": 0,
        "AuthorizationPolicy": "public",
        "Match": {
          "Path": "/docs/enrollment/swagger.json"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/v1/swagger.json"
          }
        ]
      },
      "docs-notification": {
        "ClusterId": "notification",
        "Order": 0,
        "AuthorizationPolicy": "public",
        "Match": {
          "Path": "/docs/notification/swagger.json"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/v1/swagger.json"
          }
        ]
      }
    },
    "Clusters": {
      "student": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:10"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://localhost:8081/"
          }
        }
      },
      "course": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:10"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://localhost:8082/"
          }
        }
      },
      "enrollment": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:10"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://localhost:8083/"
          }
        }
      },
      "notification": {
        "LoadBalancingPolicy": "RoundRobin",
        "HealthCheck": {
          "Passive": {
            "Enabled": true,
            "Policy": "TransportFailureRate",
            "ReactivationPeriod": "00:00:10"
          }
        },
        "HttpRequest": {
          "ActivityTimeout": "00:00:30"
        },
        "Destinations": {
          "d1": {
            "Address": "http://localhost:8084/"
          }
        }
      }
    }
  }
}