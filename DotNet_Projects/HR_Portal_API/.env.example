# Existing MySQL server (shared with the Java/Node HR Portal builds) - fill in your own values
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=change-me
MYSQL_PASSWORD=change-me

# Infrastructure (own Kafka/Redis so this stack never collides with the other HR Portal builds)
KAFKA_BOOTSTRAP=localhost:9492
REDIS_CONNECTION=localhost:9579

# Security - generate long random values (>= 32 chars)
JWT_KEY=change-me-at-least-32-characters-long
FIELD_ENCRYPTION_KEY=change-me-32-char-field-key-abcdef

# Bootstrap super admin created on first Auth Service start
HR_BOOTSTRAP_ADMIN_USERNAME=dnadmin
HR_BOOTSTRAP_ADMIN_EMAIL=dnadmin@example.com
HR_BOOTSTRAP_ADMIN_PASSWORD=change-me

# Optional
STORAGE_DIR=./storage
CORS_ORIGINS=http://localhost:3000
SMTP_HOST=
SMTP_PORT=587
