# Copy to .env and fill in MYSQL_PASSWORD. Never commit .env.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=abhig
MYSQL_PASSWORD=<your-mysql-password>
Kafka__BootstrapServers=localhost:29092
Redis__ConnectionString=localhost:26379
# HS256 signing key shared by all services (>= 32 bytes) - change outside local development
Jwt__Key=<at-least-32-characters-secret>
