# Browser-visible settings (VITE_ prefix = bundled into the client; never put secrets here)
# Base path the SPA calls. "/api/v1" goes through the Vite dev/preview proxy (same origin).
VITE_API_BASE_URL=/api/v1
# Where the dev/preview proxy forwards /api to (the Express backend).
VITE_BACKEND_URL=http://localhost:4100
VITE_APP_NAME=EMS
