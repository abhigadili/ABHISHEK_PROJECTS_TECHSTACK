# Base URL of the API gateway of the existing Node.js backend
# (Documents/PROJECTS_TECKSTACK/NodeJS_Projects/HospitalManagement). Verified: http://localhost:30080
# All ten microservices are reached through this single gateway - there are no per-service URLs.
VITE_API_BASE_URL=http://localhost:30080

# true  -> the browser calls the same origin (/api/...) and the Vite dev/preview server proxies it to VITE_API_BASE_URL
#          (no CORS involved, works for `npm run dev` and `npm run preview`).
# false -> the browser calls VITE_API_BASE_URL directly (the gateway allows any origin by default: CORS_ORIGINS=*).
VITE_USE_PROXY=true

# Request timeout for API calls in milliseconds.
VITE_API_TIMEOUT_MS=20000

# Idle time (minutes) before the session is closed automatically.
VITE_IDLE_LOGOUT_MINUTES=30

# Set to true when building to enable React <Profiler> measurements in the production bundle (Render Profiler page).
VITE_PROFILING=false
