# Production build. Default: same-origin /api (a reverse proxy - nginx, or `vite preview` locally - forwards /api to the Java gateway).
# This avoids CORS entirely. To call the gateway directly instead, set VITE_USE_PROXY=false and add this site's origin to the gateway's HR_CORS_ORIGINS.
VITE_API_BASE_URL=http://localhost:9080
VITE_USE_PROXY=true
VITE_APP_TITLE=HR Portal
