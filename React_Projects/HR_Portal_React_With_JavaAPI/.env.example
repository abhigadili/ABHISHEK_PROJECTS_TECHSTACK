# Java API gateway (the HR_Portal_API gateway listens on 9080 by default - see its docs/).
VITE_API_BASE_URL=http://localhost:9080
# true = the browser calls same-origin /api (Vite dev/preview proxy forwards to VITE_API_BASE_URL).
# false = the browser calls VITE_API_BASE_URL directly (the gateway must allow this origin via HR_CORS_ORIGINS).
VITE_USE_PROXY=true
VITE_APP_TITLE=HR Portal
