<!doctype html>
<html lang="en">
<head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}Student Management{% endblock %}</title></head>
<body style="margin:0;padding:24px;background:#f4f6f8;font-family:Segoe UI,Arial,sans-serif;color:#1d2733;">
  <table role="presentation" width="100%" cellspacing="0" cellpadding="0" style="max-width:560px;margin:0 auto;background:#ffffff;border-radius:8px;overflow:hidden;">
    <tr><td style="background:#0f3460;color:#ffffff;padding:18px 24px;font-size:18px;font-weight:600;">Student Management System</td></tr>
    <tr><td style="padding:24px;line-height:1.55;font-size:15px;">
      <p style="margin-top:0">Hello {{ name | default("there") }},</p>
      {% block content %}{% endblock %}
      <p style="margin-bottom:0">Kind regards,<br>The Student Management Team</p>
    </td></tr>
    <tr><td style="padding:14px 24px;background:#eef1f5;color:#6b7785;font-size:12px;">This is an automated message; please do not reply.</td></tr>
  </table>
</body>
</html>
