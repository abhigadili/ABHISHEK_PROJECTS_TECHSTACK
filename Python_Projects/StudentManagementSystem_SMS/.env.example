# Copy to .env and fill in. Secrets have NO defaults in code.
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_FORMAT=text            # json | text

MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=<mysql user with CREATE privilege>
MYSQL_PASSWORD=<mysql password>

JWT_SECRET=<long random string, e.g. python -c "import secrets;print(secrets.token_urlsafe(48))">
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

BOOTSTRAP_ADMIN_EMAIL=admin@sms.example.com
BOOTSTRAP_ADMIN_PASSWORD=<strong password for the first admin>

EMAIL_BACKEND=file         # file | console | smtp
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_START_TLS=true

RATE_LIMIT_DEFAULT=120/minute
RATE_LIMIT_AUTH=20/minute
RATE_LIMIT_LOGIN=5/minute

# Optional OpenID Connect provider (Auth service). Leave blank to disable.
# OIDC_ISSUER=https://accounts.example.com
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/oidc/callback

# docker compose only: root password of the *containerised* MySQL
MYSQL_ROOT_PASSWORD=<choose one>
